# Hors Docker. Sous docker compose, DATABASE_URL est reconstruite vers le service `db` depuis POSTGRES_*.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/feuilles_temps
POSTGRES_USER=amzer
POSTGRES_PASSWORD=
POSTGRES_DB=feuilles_temps

# Images du GitHub Container Registry (ghcr.io) (voir README). POSTGRES_PASSWORD doit être celui utilisé à la création de l'image db.
IMAGE_REGISTRY=ghcr.io/victor-mkw
IMAGE_TAG=latest
# Min 32 caractères. Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

FINANCE_TOKEN_EXPIRE_MINUTES=15
FINANCE_KDF_ITERATIONS=600000
FINANCE_KDF_SALT_BYTES=16

CORS_ORIGINS=["http://localhost:8050"]
SQL_ECHO=false
# Pool par worker : connexions max Postgres >= WEB_CONCURRENCY x (DB_POOL_SIZE + DB_MAX_OVERFLOW)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
WEB_CONCURRENCY=4
ENABLE_DOCS=true
